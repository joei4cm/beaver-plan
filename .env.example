# ── Beaver Plan / 海狸旅行 — environment template ──────────────────────────
# Copy to apps/web/.env.local, apps/api/.dev.vars (or root .env) as needed.
# Never commit real secrets.

# ── Clerk (Auth) — Slice D ─────────────────────────────────────────────────
# Create an application at https://dashboard.clerk.com
# Without real keys the apps stay in demo mode (X-Beaver-User-Id → demo-user).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# Same publishable key for Workers JWT issuer derivation (optional if CLERK_JWT_ISSUER set)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Optional explicit issuer, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER=
# Expo
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# WeChat OAuth via Clerk social connection (no fake WeChat AppID/secret here)
# 1) Clerk Dashboard → User & Authentication → Social connections → WeChat
# 2) Configure WeChat Open Platform credentials in Clerk (not in this repo)
# 3) Add callback URL from Clerk dashboard into WeChat open platform
# 4) Flip these flags so UI surfaces the WeChat entry:
NEXT_PUBLIC_CLERK_WECHAT_ENABLED=false
EXPO_PUBLIC_CLERK_WECHAT_ENABLED=false
CLERK_WECHAT_ENABLED=false

# Public web origin used when minting invite URLs from the API
PUBLIC_WEB_ORIGIN=http://localhost:3000

# Web / Mobile → API
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# Database (Neon / Postgres) — required for trip / journal / member persistence
# 1) Create a free project at https://console.neon.tech
# 2) Copy the connection string (prefer pooled / -pooler host for Workers)
# 3) Put it in apps/api/.dev.vars (local) and `wrangler secret put DATABASE_URL` (prod)
# 4) Apply schema: pnpm --filter @beaver/api db:migrate
# Without DATABASE_URL, /v1/trips|/v1/invites|/v1/share return HTTP 503 (no silent memory fallback).
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 — Slice C media is in-memory until you bind the bucket
# (see apps/api/wrangler.toml [[r2_buckets]] + README “Media / R2”).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=beaver-plan-media
R2_PUBLIC_BASE_URL=

# ── Maps (Slice B) ─────────────────────────────────────────────────────────
# Server keys stay on Workers / apps/api/.dev.vars — never in client bundles.
# Without these, Places + Directions use curated demo data (Kyoto / CN POIs).

# Google Maps Platform — enable Places API (New) + Routes API
GOOGLE_MAPS_SERVER_KEY=
# Optional browser key (HTTP referrer restricted) for a future Maps JS overlay
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

# 高德开放平台 — Web服务 key for BFF; JS key optional for client SDK later
AMAP_SERVER_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
EXPO_PUBLIC_AMAP_KEY=

# Product defaults: Google unless auto-detects mainland CN → Amap
DEFAULT_MAP_ENGINE=google
MAP_AUTO_AMAP_CN=true

# ── Live translation (Slice E) ─────────────────────────────────────────────
# Keys stay server-side (apps/api/.dev.vars / wrangler secrets). Never commit.
# Without keys the BFF serves scripted bilingual demo turns (UI still works).

FEATURE_TRANSLATION=true

# OpenAI-compatible (LLM translate + Whisper ASR + TTS + vision OCR/caption)
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway (default https://api.openai.com/v1)
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_ASR_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Optional Deepgram ASR (used when ASR_PROVIDER=deepgram or auto + key set)
DEEPGRAM_API_KEY=

# Pluggable providers: auto | openai | deepgram | edge | demo
# auto picks live providers when keys exist; otherwise demo.
ASR_PROVIDER=auto
LLM_PROVIDER=auto
# edge = device/browser SpeechSynthesis (no server audio bytes)
TTS_PROVIDER=auto

# Product defaults
DEFAULT_LOCALE=zh-CN
