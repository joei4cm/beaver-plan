{
  "name": "beaver-plan",
  "private": true,
  "version": "0.0.0",
  "description": "Beaver Plan / 海狸旅行 — map-first travel OS",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @beaver/web --filter @beaver/api dev",
    "dev:web": "pnpm --filter @beaver/web dev",
    "dev:mobile": "pnpm --filter @beaver/mobile start",
    "dev:api": "pnpm --filter @beaver/api dev",
    "build": "pnpm -r --filter=!@beaver/mobile build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @beaver/api db:migrate",
    "db:generate": "pnpm --filter @beaver/api db:generate",
    "smoke:neon-r2": "pnpm --filter @beaver/api smoke:neon-r2",
    "smoke:clerk": "pnpm --filter @beaver/api smoke:clerk",
    "smoke:maps": "pnpm --filter @beaver/api smoke:maps",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
