{
  "expo": {
    "name": "Beaver Plan",
    "slug": "beaver-plan",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "beaverplan",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f4339",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "plan.beaver.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f4339"
      },
      "package": "plan.beaver.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Beaver Plan to attach trip journal photos.",
          "cameraPermission": "Allow Beaver Plan to capture trip journal photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
