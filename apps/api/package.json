{
  "name": "@beaver/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts --port 8787",
    "deploy": "wrangler deploy --env production",
    "deploy:dry": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "echo \"Workers build via wrangler deploy\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "smoke:collab-schema": "tsx scripts/smoke-collab-schema.mjs",
    "smoke:neon-r2": "tsx scripts/smoke-neon-r2.mjs",
    "smoke:clerk": "tsx scripts/smoke-clerk.mjs"
  },
  "dependencies": {
    "@beaver/core": "workspace:*",
    "@beaver/i18n": "workspace:*",
    "@neondatabase/serverless": "^1.2.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.5",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "postgres": "^4.1.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.4.0"
  }
}
